<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="coffee logo no text.png" />
    <None Remove="coffee logo.png" />
    <None Remove="taskbar background colour.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="coffee logo no text.png" />
    <EmbeddedResource Include="coffee logo.png" />
    <EmbeddedResource Include="taskbar background colour.png" />
  </ItemGroup>

</Project>
