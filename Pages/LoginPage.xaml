<Page x:Class="beanbrew.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:beanbrew.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="584"
      Title="LoginPage">

    <Grid Background="#f3d2b3">
        <Border Width="380"
                Padding="32"
                Background="White"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Bean and Brew"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#6F4E37"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Your daily coffee rewards"
                           FontSize="14"
                           Foreground="#806B5D"
                           Margin="0,6,0,28"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Email address"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="EmailTextBox"
                         Height="40"
                         Padding="10"
                         FontSize="14"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Password"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="PasswordInput"
                             Height="40"
                             Padding="10"
                             FontSize="14"
                             Margin="0,0,0,12"/>

                <TextBlock x:Name="ErrorMessage"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Visibility="Collapsed"/>

                <Button Content="Sign In"
        Height="44"
        Background="#6F4E37"
        Foreground="White"
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        Click="LoginButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="10">

                                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>

                                <!-- Hover: darker coffee brown -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#4A3326"/>
                                </Trigger>

                                <!-- Pressed: warm caramel -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#B8895B"/>
                                </Trigger>

                                <!-- Disabled -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.5"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <Button Content="Create an account"
        Margin="0,12,0,0"
        Height="38"
        Background="Transparent"
        Foreground="#6F4E37"
        BorderThickness="0"
        Cursor="Hand"
        Click="RegisterButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RegisterBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="8,4">
                                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RegisterBorder"
                            Property="Background"
                            Value="#F0E2D1"/>
                                    <Setter Property="Foreground"
                            Value="#4A3326"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="RegisterBorder"
                            Property="Background"
                            Value="#D8C0A5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Page>