<Page x:Class="beanbrew.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:beanbrew.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1796.994" d:DesignWidth="567"
      Title="HomePage">

    <Grid>
        <Rectangle Margin="0,0,0,0" Fill="#FFFFFFFF"/>
        <Image Source="/Pages/john making coffee.jpg" Margin="-487,-133,-467,728"/>
        <Rectangle HorizontalAlignment="Left" Height="865" Margin="-72,929,0,0" VerticalAlignment="Top" Width="796" RenderTransformOrigin="0.502,0.492">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFB48F59"/>
                    <GradientStop Color="#FFF3D2B3" Offset="0.45"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle HorizontalAlignment="Left" Height="154" Margin="-56,784,0,0" VerticalAlignment="Top" Width="765">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop/>
                    <GradientStop Color="#FFB6915C" Offset="0.77"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Label Content="OUR STORY" HorizontalAlignment="Left" Height="86" Margin="27,1020,0,0" VerticalAlignment="Top" Width="442" FontFamily="Segoe UI Semibold" FontSize="55"/>
        <!-- Label Content="Created in 2007, Bean &amp; Brew is the product of our shared passion for coffee. Our motto: &quot;everyone deserves a cup of joy.&quot;" HorizontalAlignment="Left" Height="115" Margin="27,1106,0,0" VerticalAlignment="Top" Width="498" FontSize="24"  /-->
        <Label HorizontalAlignment="Left" Height="190" Margin="52,1106,0,0" VerticalAlignment="Top" Width="442" FontSize="24">
            <TextBlock TextWrapping="Wrap" ><Run Text="Created in 2007, Bean &amp; Brew is the product of our shared passion for coffee. Our motto: &quot;everyone deserves a cup of joy."/><Run Text="&quot;"/><LineBreak/><Run Text="-"/><Run Text=" John and Barbara"/></TextBlock>
        </Label>
        <Label Content="VISIT US" HorizontalAlignment="Left" Margin="27,1320,0,0" VerticalAlignment="Top" FontSize="55" FontFamily="Segoe UI Semibold"/>
        <Label HorizontalAlignment="Left" Height="76" Margin="52,1408,0,0" VerticalAlignment="Top" Width="442" FontSize="24">
            <TextBlock TextWrapping="Wrap" Width="395" ><Run Text="21 Brewing"/><Run Text=" "/><Run Text="Road"/><Run Text=", "/><Run Text="Holmfirth"/><LineBreak/><Run Text="HD9 3CF"/></TextBlock>
        </Label>
        <Image HorizontalAlignment="Left" Height="212" Margin="0,1514,0,0" VerticalAlignment="Top" Width="232" Source="/Pages/awards photo EDITED.png"/>
        <!--Image HorizontalAlignment="Right" Height="100" Margin="0,1570,223,0" VerticalAlignment="Top" Width="160" Source="/Pages/5ecec6ef73e4440004f09e75.png"/-->
        <Button HorizontalAlignment="Right" Height="130" Width="130" Margin="10,1555,223,0" VerticalAlignment="Top" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}" Click="InstagramButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>

            <Image Width="118" Height="118" Source="/Pages/5ecec6ef73e4440004f09e75.png" Stretch="Uniform"/>
        </Button>
        <Label Content="Follow us on&#xD;&#xA;Instagram" HorizontalAlignment="Left" Height="80" Margin="344,1580,0,0" VerticalAlignment="Top" Width="148" FontSize="24" FontFamily="Segoe UI Semibold"/>
    </Grid>
</Page>
